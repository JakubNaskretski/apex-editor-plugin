{
  "name": "apex-editor",
  "displayName": "Apex Editor",
  "description": "Multi-tab Apex editor for Salesforce with quick anonymous Apex execution against any authenticated org.",
  "version": "0.4.0",
  "publisher": "Skrety",
  "icon": "plugin-icon.png",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "salesforce",
    "apex",
    "sf",
    "sfdx",
    "anonymous apex",
    "crm"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "apex-editor-panel",
          "title": "Apex Editor",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "apex-editor-panel": [
        {
          "type": "webview",
          "id": "apexEditor.panelView",
          "name": "Apex Scripts"
        }
      ]
    },
    "commands": [
      {
        "command": "apexEditor.execute",
        "title": "Apex: Execute Active Script",
        "icon": "$(play)"
      },
      {
        "command": "apexEditor.executeEditor",
        "title": "Apex: Run Current File / Selection as Anonymous Apex",
        "icon": "$(play)"
      },
      {
        "command": "apexEditor.selectOrg",
        "title": "Apex: Select Org"
      },
      {
        "command": "apexEditor.newTab",
        "title": "Apex: New Script Tab",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "apexEditor.execute",
          "when": "view == apexEditor.panelView",
          "group": "navigation@1"
        },
        {
          "command": "apexEditor.newTab",
          "when": "view == apexEditor.panelView",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "apexEditor.executeEditor",
          "when": "editorLangId == apex || resourceExtname == .apex",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "apexEditor.executeEditor",
          "when": "editorLangId == apex || resourceExtname == .apex"
        }
      ]
    },
    "keybindings": [
      {
        "command": "apexEditor.execute",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "focusedView == apexEditor.panelView"
      },
      {
        "command": "apexEditor.executeEditor",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && (editorLangId == apex || resourceExtname == .apex)"
      }
    ],
    "configuration": {
      "title": "Apex Editor",
      "properties": {
        "apexEditor.executeTimeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "maximum": 300000,
          "description": "Timeout in milliseconds for anonymous Apex execution."
        },
        "apexEditor.apiVersion": {
          "type": "string",
          "default": "60.0",
          "description": "Salesforce API version used for Tooling API calls."
        },
        "apexEditor.syncOrgWithFamily": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Follow and publish the Salesforce org shared across the Skrety SF plugins (`skrety.salesforce.targetOrg`). Off: this plugin keeps its own org and ignores switches made in sibling plugins."
        },
        "apexEditor.confirmProductionRun": {
          "type": "boolean",
          "default": true,
          "description": "Show a confirmation dialog before running anonymous Apex against a production org (anonymous Apex executes immediately against live data)."
        },
        "apexEditor.customSnippets": {
          "type": "array",
          "default": [],
          "markdownDescription": "Your own code suggestions, added on top of the built-ins. Type a prefix in the editor and press Tab or Enter to insert. Use `$0` to mark where the caret lands; `$1` / `${1:placeholder}` also work (VS Code snippet syntax). A custom entry with the same `prefix` as a built-in overrides it.",
          "items": {
            "type": "object",
            "required": [
              "prefix",
              "body"
            ],
            "properties": {
              "prefix": {
                "type": "string",
                "description": "What you type to trigger the suggestion, e.g. \"sd\"."
              },
              "label": {
                "type": "string",
                "description": "Text shown in the popup (defaults to the prefix). Also matched as you type, so a label of \"System.debug\" is suggested when you type \"system\"."
              },
              "body": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "The inserted text. A string (use \\n for newlines) or an array of lines. Use $0 for the caret position.",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string",
                "description": "Optional hint shown to the right of the suggestion."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node ./scripts/copy-panel-js.mjs",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "package": "npx -y @vscode/vsce@latest package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.105.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
